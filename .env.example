# NextAuth
NEXTAUTH_URL=https://markets.studex.group
NEXTAUTH_SECRET=your-secret-key-here

# GCP
GCP_PROJECT_ID=studex-global-markets
GCP_CLIENT_ID=your-gcp-client-id.apps.googleusercontent.com
GCP_CLIENT_SECRET=your-gcp-client-secret
GOOGLE_APPLICATION_CREDENTIALS=./gcp-service-account.json

# Stripe (5-tier pricing)
STRIPE_PUBLIC_KEY=pk_live_xxx
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Database (Cloud SQL)
DATABASE_URL=postgresql://user:pass@cloudsql-proxy/studex_global_markets

# Naledi Nexus API
NALEDI_API_URL=http://localhost:3100
NALEDI_API_KEY=your-naledi-key

# Deployment
VERCEL_ENV=production
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_API_TOKEN=your-api-token
